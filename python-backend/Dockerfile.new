# syntax=docker/dockerfile:1.9

# ============================================================================
# QuotePro backend — multi-stage build with uv.
# ============================================================================

# ---- Stage 1: install dependencies ----------------------------------------
FROM ghcr.io/astral-sh/uv:0.5-python3.12-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv

WORKDIR /app

COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

COPY src ./src
COPY config ./config
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# ---- Stage 2: runtime ------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 1000 quotepro \
    && useradd  --system --uid 1000 --gid quotepro --create-home quotepro

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY --from=builder --chown=quotepro:quotepro /opt/venv /opt/venv
COPY --from=builder --chown=quotepro:quotepro /app/src ./src
COPY --from=builder --chown=quotepro:quotepro /app/config ./config

USER quotepro

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s \
    CMD curl --fail --silent http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "quotepro.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
