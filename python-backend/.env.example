# Rivet — AI service environment
#
#   cp .env.example .env
#
# Only ai_backend.py runs. Everything else under python-backend/ is dead code
# from earlier rebuild attempts — see docs/CODEBASE_MAP.md.

# ─── Supabase ────────────────────────────────────────────────────────────────
# The service reads catalog_items and company settings with the service-role key.
# Local: `supabase status` gives you both. Use 127.0.0.1, not localhost.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>

# ─── Gemini ──────────────────────────────────────────────────────────────────
# OPTIONAL. Without a key the service falls back to a keyword matcher over the
# catalog and reports "mode": "mock" — the whole quote flow still works offline.
# Ask Dipen for a key when you want real generation.
#
# Google models only. See CLAUDE.md; this is a standing decision.
GEMINI_API_KEY=

# Tried in order until one succeeds, so a quota limit degrades instead of failing.
GEMINI_MODELS=gemini-2.5-flash,gemini-flash-latest,gemini-2.5-flash-lite,gemini-flash-lite-latest,gemini-2.0-flash

# ─── Auth ────────────────────────────────────────────────────────────────────
# Shared secret required on every /api/* request. Must match the value in the
# frontend's .env.local. Generate with: openssl rand -hex 32
RIVET_BACKEND_SECRET=dev-local-secret-change-me

# ─── CORS ────────────────────────────────────────────────────────────────────
# The browser no longer calls this service directly — quote generation goes
# through a Next.js server action — so this can stay empty in deployed
# environments. Kept for local debugging with curl/Swagger.
ALLOWED_ORIGINS=http://localhost:3000

# ─── Vertex AI (optional, not used today) ────────────────────────────────────
# Vertex authenticates via Application Default Credentials rather than an API
# key, which Railway does not provide natively. If you want Vertex, run this
# service on Cloud Run instead. See docs/adr/0005.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
