# =============================================================================
# QuotePro Backend — Environment Variables (v2)
# Copy to `.env` and fill in real values. All QP_* vars are optional overrides.
# =============================================================================

# ---- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Direct Postgres URL for LISTEN/NOTIFY + PostgresSessionService
SUPABASE_DB_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# ---- AI (required) ----------------------------------------------------------
GEMINI_API_KEY=

# ---- Redis / arq (required for indexer worker) ------------------------------
QP_REDIS_URL=redis://localhost:6379/0

# ---- App metadata -----------------------------------------------------------
QP_ENV=local                         # local | preview | production
QP_HOST=0.0.0.0
QP_PORT=8000
QP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
QP_DEBUG=false

# ---- AI tuning --------------------------------------------------------------
QP_GEMINI_MODEL_DEFAULT=gemini-2.0-flash
QP_GEMINI_MODEL_REASONING=gemini-2.0-flash-thinking-exp-1219
QP_GEMINI_EMBEDDING_MODEL=text-embedding-004
QP_AI_TEMPERATURE=0.1
QP_AI_MAX_TOKENS=4096
QP_AI_RAG_TOP_K=5
QP_AI_RAG_RRF_K=60

# ---- Rate limits (per user, per minute) -------------------------------------
QP_RL_AI_PER_MIN=10
QP_RL_CRUD_PER_MIN=100
QP_RL_PUBLIC_PER_MIN=30

# ---- Feature flags ----------------------------------------------------------
QP_ENABLE_RAG=true
QP_ENABLE_RATE_LIMITING=true
QP_ENABLE_COST_TRACKING=true
QP_ENABLE_TELEMETRY=false

# ---- Logging + observability ------------------------------------------------
QP_LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
QP_LOG_JSON=true
QP_OTEL_ENDPOINT=                    # https://api.honeycomb.io/v1/traces (optional)
QP_OTEL_SERVICE_NAME=quotepro-api
QP_SENTRY_DSN=
QP_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- Integrations (all optional) --------------------------------------------
QP_RESEND_API_KEY=
QP_RESEND_FROM_EMAIL=no-reply@quotepro.demo

QP_TWILIO_ACCOUNT_SID=
QP_TWILIO_AUTH_TOKEN=
QP_TWILIO_FROM_NUMBER=

QP_STRIPE_SECRET_KEY=
QP_STRIPE_WEBHOOK_SECRET=

QP_DROPBOX_SIGN_API_KEY=
QP_DROPBOX_SIGN_WEBHOOK_SECRET=

QP_LEMONSQUEEZY_WEBHOOK_SECRET=
