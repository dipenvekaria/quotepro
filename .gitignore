# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the templates must ship, or a fresh clone has nothing to copy from.
!.env.example
!python-backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
python-backend/__pycache__/
python-backend/venv/
python-backend/.env
*.pyc
*.pyo
*.pyd
.Python

# Documentation archive
docs/archive/
!docs/archive/pre-rebuild/
!docs/archive/pre-rebuild/**

# Temporary files
*.log
*.tmp
*.swp

# iCloud: keep real deps local, out of iCloud sync (node_modules -> node_modules.nosync)
*.nosync
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Claude Code — share the team config, keep personal overrides local.
# .claude/settings.json and .claude/skills/ ARE committed on purpose: they are
# how every engineer gets the same plugins, skills, and project context.
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Generated PDFs (local testing)
/generated-pdfs/
*.pdf
# ...except the primer, which is a versioned deliverable. Named explicitly so a
# stray browser "Save as PDF" dropped into docs/ can't get committed alongside it.
!docs/Rivet-Engineering-Primer.pdf

# Primer build intermediates — regenerate with docs/primer/build-pdf.py
docs/primer/rivet-primer-print.html
docs/primer/_preview.html
docs/primer/pages/
