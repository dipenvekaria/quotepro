# Rivet — frontend environment
#
#   cp .env.example .env.local
#
# The values below are the LOCAL DEV defaults. Fill in the three marked <from
# `supabase status`> after running `supabase start`, and you have a working app.
#
# src/lib/env.ts validates all of this with Zod at boot and fails loudly with the
# name of whatever is missing. Read the error rather than guessing.

# ─── Supabase (auth only — data goes through DATABASE_URL) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<from `supabase status`>
# Only needed if you add JWT verification to the Python backend.
# SUPABASE_JWT_SECRET=<from `supabase status`>

# ─── Database ────────────────────────────────────────────────────────────────
# Read directly by src/lib/db/index.ts. NOTE: this one is NOT covered by the Zod
# schema in env.ts, so a missing/typo'd value fails at query time with a
# connection error rather than at boot. Double-check it.
#
# Local:  the Supabase Postgres that `supabase start` boots on :54322
# Hosted: use the TRANSACTION-MODE POOLER (port 6543), never the direct 5432
#         connection — the pool is max:5 per instance and serverless concurrency
#         will exhaust the direct connection limit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI (Gemini) ─────────────────────────────────────────────────────────────
# Gemini runs in-process inside the server actions — there is no separate AI
# service to start (docs/adr/0009-ai-in-process.md).
#
# Optional. Without a key, quote generation degrades to keyword-matching the
# catalog (`mode: "mock"`) and the customer summary renders nothing, so the app
# is fully usable offline. Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Fallback chain, tried in order. Unset uses the default in src/lib/ai/gemini.ts.
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Optional locally: without a key, mail is skipped. `supabase start` also runs
# Inbucket on http://localhost:54324, which catches auth emails.
# RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@rivet.demo

# ─── Payments (Stripe — test mode) ───────────────────────────────────────────
# Optional locally. Needed to exercise checkout and Connect onboarding.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PLATFORM_FEE_BPS=0

# ─── E-signature ─────────────────────────────────────────────────────────────
# Optional. Without it, the quote viewer falls back to instant acceptance.
# DROPBOX_SIGN_API_KEY=

# ─── Observability (not yet wired — see docs/LAUNCH_PLAN.md) ─────────────────
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Not wired ───────────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN — SMS, in deps but unused
# LEMONSQUEEZY_API_KEY — Rivet's own billing, does not exist yet
